# ------------------------------------------------------------------------------
# ThingSpeak Environment Configuration
# ------------------------------------------------------------------------------

# Rails Environment settings
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true

# Database Configuration
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USERNAME=thing
DATABASE_PASSWORD=speak
DATABASE_NAME=thingspeak_production

# Redis / Resque Configuration
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# Application Domain & IP Settings
API_DOMAIN=http://localhost:3000/
APPLICATION_IP_ADDRESS=127.0.0.1
RESET_PASSWORD_URL=http://localhost:3000/users/reset_password/
HTTP_HEADER_API_KEY_NAME=THINGSPEAKAPIKEY

# SMTP Mail Server Settings
SMTP_DELIVERY_METHOD=smtp
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_AUTHENTICATION=plain
SMTP_USER_NAME=
SMTP_PASSWORD=

# Twitter API Credentials (Optional)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
